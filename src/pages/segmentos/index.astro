---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Section from "../../components/Section.astro";
import CTA from "../../components/CTA.astro";
import PageMedia from "../../components/PageMedia.astro";
import { mediaForSegment, pageMedia } from "../../data/media";
import { segments } from "../../data/segments";
---

<BaseLayout
  title="Segmentos"
  description="Segmentos atendidos pela DS Científica com calibração, manutenção, qualificação e produtos definidos por aplicação."
>
  <Breadcrumbs
    items={[{ label: "Início", href: "/" }, { label: "Segmentos" }]}
  />
  <section class="container minimal-hub">
    <div class="minimal-hub-heading">
      <div>
        <p class="eyebrow">Segmentos</p><h1>Soluções por contexto de uso.</h1><p
          class="lead"
        >
          Cada segmento reúne aplicações, soluções e instrumentos relacionados
          para orientar a navegação até o orçamento central da DS Científica.
        </p>
      </div><PageMedia media={pageMedia.segmentos} priority />
    </div>
  </section>
  <Section eyebrow="Navegação" title="Escolha o segmento." tone="light"
    ><div class="grid">
      {
        segments.map((segment) => (
          <article class="card card-active segment-navigation-card">
            <PageMedia media={mediaForSegment(segment.slug)} compact />
            <h3>
              <a href={segment.href}>
                {segment.extendedLabel || segment.title}
                <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{segment.description}</p>
          </article>
        ))
      }
    </div></Section
  >
  <CTA />
</BaseLayout>
