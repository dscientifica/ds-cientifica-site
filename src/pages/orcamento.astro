---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout
  title="Solicitar orçamento"
  description="Acesse o fluxo central de solicitação de orçamento da DS Científica."
>
  <Breadcrumbs
    items={[
      { label: "Início", href: "/" },
      { label: "Contato", href: "/contato" },
      { label: "Solicitar orçamento" },
    ]}
  />
  <section class="container minimal-hub">
    <div class="minimal-hub-heading">
      <div>
        <p class="eyebrow">Orçamento DS Científica</p><h1>
          Solicite orçamento pelo fluxo central.
        </h1><p class="lead">
          O formulário de orçamento está concentrado na página de contato para
          manter a solicitação organizada em um único lugar.
        </p><a class="button" href="/contato#orcamento"
          >Ir para o orçamento <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
