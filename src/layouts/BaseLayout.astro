---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
import "../styles/global.css";
import "../styles/quote-review.css";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/\/$/, "") || "/",
  Astro.site,
);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | DS Científica</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={!site.indexable || noindex
        ? "noindex, nofollow"
        : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${title} | DS Científica`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#102a43" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    ><a class="skip-link" href="#conteudo">Pular para o conteúdo</a><Header
    /><main id="conteudo"><slot /></main><Footer /></body
  >
</html>
