---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import CTA from "../components/CTA.astro";
import PageMedia from "../components/PageMedia.astro";
import { mediaForKey } from "../data/media";
import { rangeMessage, type CalibrationQuantity } from "../data/catalog";
import { calibrationQuantitySeo } from "../data/seo";
interface Props {
  quantity: CalibrationQuantity;
}
const { quantity } = Astro.props;
const seo = calibrationQuantitySeo[quantity.slug];
const pageTitle = seo?.title || `Calibração de ${quantity.title}`;
const pageHeading = seo?.h1 || `Calibração de ${quantity.title}`;
const pageDescription = seo?.description || quantity.description;
const pageLead = seo?.lead || quantity.intro;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Breadcrumbs
    items={[
      { label: "Início", href: "/" },
      { label: "Calibração", href: "/calibracao" },
      { label: quantity.title },
    ]}
  />
  <Hero
    eyebrow="Calibração"
    title={pageHeading}
    description={pageLead}
    href="#equipamentos"
    cta="Ver equipamentos"
  >
    <PageMedia media={mediaForKey(quantity.slug)} priority />
  </Hero>
  {
    seo?.sections.map((section) => (
      <Section
        eyebrow={section.eyebrow}
        title={section.title}
        intro={section.intro}
        tone={section.tone}
      >
        {section.columns && (
          <div class="split">
            {section.columns.map((column) => (
              <div class="prose">
                <h3>{column.title}</h3>
                <p>{column.body}</p>
                {column.items && (
                  <ul>
                    {column.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        )}
        {section.links && (
          <div class="grid">
            {section.links.map((link) => (
              <Card
                title={link.label}
                description={link.description}
                href={link.href}
              />
            ))}
          </div>
        )}
      </Section>
    ))
  }
  <Section
    id="equipamentos"
    eyebrow="Equipamentos"
    title="Escolha o tipo de instrumento."
    intro="As páginas abaixo explicam aplicações, critérios de especificação e dados necessários para orçamento, sem publicar faixas ou capacidades não confirmadas."
    tone="light"
  >
    <div class="grid">
      {
        quantity.equipment.map((item) => (
          <Card
            title={item.title}
            description={item.description}
            href={`/calibracao/${quantity.slug}/${item.slug}`}
          />
        ))
      }
    </div>
  </Section>
  <Section
    eyebrow="Análise técnica"
    title="A aplicação define o melhor caminho."
  >
    <div class="split">
      <div class="prose">
        <h3>Por que calibrar</h3><p>{quantity.importance}</p><p>
          A calibração fornece informação metrológica para apoiar decisões. Ela
          não equivale automaticamente a ajuste, aprovação ou declaração de
          conformidade.
        </p>
      </div><div class="prose">
        <h3>Antes do orçamento</h3><p>{rangeMessage}</p><p>
          Informe dados do instrumento, faixa utilizada, quantidade, cidade/UF e
          requisitos internos para que a DS avalie a solução adequada.
        </p>
      </div>
    </div>
  </Section>
  <CTA
    title={`Precisa de orçamento para calibração de ${quantity.title}?`}
    context={`Calibração / ${quantity.title}`}
  />
</BaseLayout>
