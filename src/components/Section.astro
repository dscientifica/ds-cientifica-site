---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: "light" | "white";
}
const { id, eyebrow, title, intro, tone = "white" } = Astro.props;
---

<section
  id={id}
  class:list={["section", { "section-light": tone === "light" }]}
>
  <div class="container">
    <div class="section-heading">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2>{title}</h2>{
        intro && <p>{intro}</p>
      }
    </div><slot />
  </div>
</section>
