---
import Brand from "./Brand.astro";
import { navigation } from "../config/site";
import { pageHref } from "../utils/urls";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container header-main">
    <a href="/" class="brand-link" aria-label="DS Científica — Início"
      ><Brand /></a
    >
    <p class="header-caption">PRECISÃO QUE GERA RESULTADOS</p>
    <a class="client-link" href="/contato/#orcamento"
      >Solicitar orçamento <span aria-hidden="true">↗</span></a
    >
  </div>
  <div class="container nav-wrap">
    <button
      class="menu-toggle"
      type="button"
      aria-controls="main-nav"
      aria-expanded="false"
      hidden>Menu <span aria-hidden="true">☰</span></button
    >
    <nav id="main-nav" aria-label="Navegação principal">
      {
        navigation.map((item) => (
          <a
            href={pageHref(item.href)}
            aria-current={path === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<!-- Set the mobile menu state before the main content can paint. -->
<script is:inline>
  (() => {
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.querySelector("#main-nav");
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement))
      return;

    toggle.hidden = false;
    nav.classList.add("enhanced");
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      nav.classList.remove("is-open");
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
    });
    nav.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) close();
    });
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        close();
        toggle.focus();
      }
    });
  })();
</script>
