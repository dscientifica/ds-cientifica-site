---
import { rangeMessage } from "../data/catalog";
import { whatsappUrl } from "../config/site";
interface Props {
  href?: string;
}
const { href = "/contato#orcamento" } = Astro.props;
---

<section class="cta-section">
  <div class="container cta-box">
    <div>
      <p class="eyebrow">Sua aplicação é o ponto de partida</p><h2>
        Vamos entender o que você precisa medir?
      </h2><p>{rangeMessage}</p>
    </div><div class="cta-actions">
      <a class="button" href={href}
        >Preparar orçamento <span aria-hidden="true">↗</span></a
      >{
        whatsappUrl && (
          <a class="text-link" href={whatsappUrl} rel="noopener noreferrer">
            Conversar pelo WhatsApp ↗
          </a>
        )
      }
    </div>
  </div>
</section>
